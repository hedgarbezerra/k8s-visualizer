<WikiSectionFrame Section="@Section">
    <WikiContentBlock Blocks="@Blocks" />
</WikiSectionFrame>

@code {
    [Parameter, EditorRequired] public WikiSectionModel Section { get; set; } = default!;
    private static readonly WikiBlock[] Blocks =
    [
        new WikiParagraphBlock("Secret.Block01"),
        new WikiListItemBlock("Secret.Block02"),
        new WikiListItemBlock("Secret.Block03"),
        new WikiListItemBlock("Secret.Block04"),
        new WikiListItemBlock("Secret.Block05"),
        new WikiDiagramItem("""
flowchart LR
    S[Secret] --> P[Pod]
"""),
        new WikiParagraphBlock("Secret.Block07"),
        new WikiQuoteBlock("Secret.Block08")
        ,        new WikiParagraphBlock("Secret.ExternalIntro"),
        new WikiHeadingBlock("Secret.EsoTitle", 3),
        new WikiParagraphBlock("Secret.EsoText"),
        new WikiCodeItem("yaml", """
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: payments-db
  namespace: platform
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: production-secrets
    kind: ClusterSecretStore
  target:
    name: payments-db
    creationPolicy: Owner
  data:
    - secretKey: password
      remoteRef:
        key: apps/payments
        property: database-password
"""),
        new WikiHeadingBlock("Secret.CsiTitle", 3),
        new WikiParagraphBlock("Secret.CsiText"),
        new WikiCodeItem("yaml", """
apiVersion: secrets-store.csi.x-k8s.io/v1
kind: SecretProviderClass
metadata:
  name: payments-db
  namespace: platform
spec:
  provider: vault
  parameters:
    roleName: payments
    objects: |
      - objectName: database-password
        secretPath: secret/data/apps/payments
        secretKey: password
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: payments
  namespace: platform
spec:
  selector:
    matchLabels: { app: payments }
  template:
    metadata:
      labels: { app: payments }
    spec:
      containers:
        - name: app
          image: example/payments:1.0
          volumeMounts:
            - name: external-secrets
              mountPath: /mnt/secrets-store
              readOnly: true
      volumes:
        - name: external-secrets
          csi:
            driver: secrets-store.csi.k8s.io
            readOnly: true
            volumeAttributes:
              secretProviderClass: payments-db
"""),
        new WikiComparisonItem("Secret.NativeCompareTitle", "Secret.NativeCompareText", "Secret.ExternalCompareTitle", "Secret.ExternalCompareText"),
        new WikiHeadingBlock("Secret.ChoiceTitle", 3),
        new WikiParagraphBlock("Secret.ChoiceText"),
        new WikiReferenceBlock("https://kubernetes.io/docs/concepts/configuration/secret/", "Kubernetes Secrets"),
        new WikiReferenceBlock("https://kubernetes.io/docs/tasks/administer-cluster/encrypt-data/", "Encryption at rest"),
        new WikiReferenceBlock("https://external-secrets.io/latest/api/externalsecret/", "ExternalSecret API"),
        new WikiReferenceBlock("https://secrets-store-csi-driver.sigs.k8s.io/getting-started/usage", "Secrets Store CSI usage"),
        new WikiInternalLinkBlock("configmap", "Configmap.Title"),
        new WikiInternalLinkBlock("rbac", "Rbac.Title"),
        new WikiInternalLinkBlock("deployment", "Deployment.Title")
    ];
}
