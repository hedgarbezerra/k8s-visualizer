<WikiSectionFrame Section="@Section">
    <WikiContentBlock Blocks="@Blocks" />
</WikiSectionFrame>

@code {
    [Parameter, EditorRequired] public WikiSectionModel Section { get; set; } = default!;
    private static readonly WikiBlock[] Blocks =
    [
        new WikiParagraphBlock("Priorityclass.Block01"),
        new WikiCodeItem("text", """
Critical workload
      ↓
High priority
Normal workload
      ↓
Normal priority
Batch workload
      ↓
Low priority
"""),
        new WikiCodeItem("yaml", """
apiVersion: scheduling.k8s.io/v1
kind: PriorityClass
metadata:
  name: high-priority
value: 100000
globalDefault: false
description: "Priority for latency-sensitive workloads"
""")
    ];
}
