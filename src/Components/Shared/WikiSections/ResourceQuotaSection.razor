<WikiSectionFrame Section="@Section">
    <WikiContentBlock Blocks="@Blocks" />
</WikiSectionFrame>

@code {
    [Parameter, EditorRequired] public WikiSectionModel Section { get; set; } = default!;
    private static readonly WikiBlock[] Blocks =
    [
        new WikiParagraphBlock("Resourcequota.Block01"),
        new WikiCodeItem("text", """
Namespace dev
CPU total: 10 cores
Memory total: 20Gi
Pods: 50
"""),
        new WikiCodeItem("yaml", """
apiVersion: v1
kind: ResourceQuota
metadata:
  name: compute-budget
  namespace: demo
spec:
  hard:
    requests.cpu: "4"
    requests.memory: 8Gi
    limits.cpu: "8"
    limits.memory: 16Gi
    pods: "20"
""")
    ];
}
