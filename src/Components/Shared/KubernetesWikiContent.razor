<div class="wiki-layout">
    <aside class="wiki-index pa-4" aria-label="@L["Wiki.Contents"]">
        <MudText Typo="Typo.h6" Class="mb-3">@L["Wiki.Contents"]</MudText>
        <nav aria-label="@L["Wiki.Contents"]">
            @foreach (var group in IndexGroups)
            {
                <section class="wiki-index-group">
                    <MudText Typo="Typo.subtitle2">@group.Title</MudText>
                    <ol start="@group.StartNumber">
                        @foreach (var heading in group.Headings)
                        {
                            <li class="@(heading.Id == _currentSectionId ? "wiki-index-active" : string.Empty)">
                                <a href="/wiki#@heading.Id" @onclick="() => NavigateToHeadingAsync(heading.Id)" @onclick:preventDefault="true">@heading.Title</a>
                            </li>
                        }
                    </ol>
                </section>
            }
        </nav>
    </aside>
    <div class="wiki-main">
        <nav class="wiki-breadcrumb" aria-label="Breadcrumb">
            <a href="/wiki" @onclick:preventDefault="true" @onclick="NavigateToTopAsync">@L["Wiki.Contents"]</a>
            @if (CurrentHeading is { } current)
            {
                <span aria-hidden="true">›</span><span>@current.GroupTitle</span><span aria-hidden="true">›</span>
                <a href="/wiki#@current.Id" @onclick="() => NavigateToHeadingAsync(current.Id)" @onclick:preventDefault="true">@current.Title</a>
            }
        </nav>
        <div @ref="_articleHost" class="wiki-article">
            <MudPaper Class="wiki-intro pa-6" Elevation="1">
                <MudText Typo="Typo.h4">@L["Wiki.IntroTitle"]</MudText>
                <MudText Typo="Typo.body1">@L["Wiki.IntroDescription"]</MudText>
            </MudPaper>
            <div class="wiki-sections">
                @foreach (var section in ResolvedSections)
                {
                    <MudPaper @key="section.Id" Class="wiki-section-card pa-5">
                        <DynamicComponent Type="section.ComponentType" Parameters="@ParametersFor(section)" />
                    </MudPaper>
                }
            </div>
        </div>
        <MudFab Class="wiki-back-to-top" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.ArrowUpward"
                aria-label="@L["Wiki.BackToTop"]" title="@L["Wiki.BackToTop"]" OnClick="NavigateToTopAsync" />
    </div>
</div>
@implements IAsyncDisposable
@inject IStringLocalizer<WikiResources> L
@inject IJSRuntime JS

