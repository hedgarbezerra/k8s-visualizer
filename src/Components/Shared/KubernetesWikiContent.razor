    private ElementReference _articleHost;
    private DotNetObjectReference<KubernetesWikiContent>? _selfReference;
    private string? _currentSectionId;

    private IReadOnlyList<ResolvedWikiSection> ResolvedSections => Sections.OrderBy(section => section.Order)
        .Select(section => new ResolvedWikiSection(section.Order, section.Id, L[section.TitleKey].Value,
            L[section.GroupKey].Value, section.ComponentType)).ToArray();

    private IReadOnlyList<WikiIndexGroup> IndexGroups => ResolvedSections.GroupBy(section => section.GroupTitle)
        .Select(group => new WikiIndexGroup(group.Key, group.First().Order,
            group.Select(section => new WikiHeading(section.Id, section.Title, section.GroupTitle)).ToArray())).ToArray();

    private WikiHeading? CurrentHeading => ResolvedSections.FirstOrDefault(section => section.Id == _currentSectionId) is { } current
        ? new WikiHeading(current.Id, current.Title, current.GroupTitle) : null;

    private static Dictionary<string, object> ParametersFor(ResolvedWikiSection section) => new()
    {
        ["Section"] = new WikiSectionModel(section.Id, section.Title, section.GroupTitle)
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _selfReference = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("kvWiki.bind", _articleHost, _selfReference,
            L["Wiki.CopyCode"].Value, L["Wiki.CopiedCode"].Value, L["Wiki.DiagramError"].Value);
    }

    private Task NavigateToHeadingAsync(string id) => JS.InvokeVoidAsync("kvWiki.scrollTo", id).AsTask();
    private Task NavigateToTopAsync() => JS.InvokeVoidAsync("kvWiki.scrollToTop").AsTask();

    [JSInvokable]
    public Task OnSectionChanged(string id) => InvokeAsync(() => { _currentSectionId = id; StateHasChanged(); });

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("kvWiki.unbind", _articleHost); }
        catch (JSDisconnectedException) { }
        _selfReference?.Dispose();
    }

}
