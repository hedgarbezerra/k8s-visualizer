    private async Task RefreshWorkloadStatesAsync(IEnumerable<KubernetesResourceItem> items)
    {
        var workloads = items.Where(IsScalable).Distinct().ToArray();
        if (workloads.Length == 0) return;
        _workloadStateLoading = true;
        var states = await Task.WhenAll(workloads.Select(async item =>
        {
            try { return (Item: item, State: await ClusterService.GetWorkloadReplicaStateAsync(item)); }
            catch { return (Item: item, State: (WorkloadReplicaState?)null); }
        }));
        foreach (var (item, state) in states)
        {
            if (state is null) _workloadStates.Remove(ResourceIdentity(item));
            else _workloadStates[ResourceIdentity(item)] = state;
        }
        _workloadStateLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private Task LoadWorkloadStateAsync(KubernetesResourceItem item) => RefreshWorkloadStatesAsync([item]);
    private static bool IsScalable(KubernetesResourceItem item) => item.Kind is "Deployment" or "StatefulSet" or "ReplicaSet";
    private bool IsStoppable(KubernetesResourceItem item) => IsScalable(item)
        && _workloadStates.TryGetValue(ResourceIdentity(item), out var state) && state.CurrentReplicas > 0;
    private bool IsResumable(KubernetesResourceItem item) => IsScalable(item)
        && _workloadStates.TryGetValue(ResourceIdentity(item), out var state)
        && state.CurrentReplicas == 0 && state.PreviousReplicas is > 0;
    private static Color GetResourceStatusColor(string status)
    {
        if (status.Equals("N/A", StringComparison.OrdinalIgnoreCase)) return Color.Default;
        if (status.Contains("Failed", StringComparison.OrdinalIgnoreCase) || status.Contains("BackOff", StringComparison.OrdinalIgnoreCase)
            || status.Contains("Error", StringComparison.OrdinalIgnoreCase) || status.Contains(": False", StringComparison.OrdinalIgnoreCase)) return Color.Error;
        if (status.Contains("Terminating", StringComparison.OrdinalIgnoreCase) || status.Contains("Encerrando", StringComparison.OrdinalIgnoreCase)
            || status.Contains("Pending", StringComparison.OrdinalIgnoreCase) || status.Contains("Progressing", StringComparison.OrdinalIgnoreCase)) return Color.Warning;
        var readiness = System.Text.RegularExpressions.Regex.Match(status, @"^(\d+)/(\d+)");
        if (readiness.Success && int.TryParse(readiness.Groups[1].Value, out var ready) && int.TryParse(readiness.Groups[2].Value, out var desired))
            return desired == 0 ? Color.Default : ready >= desired ? Color.Success : Color.Warning;
        return status.Contains("Running", StringComparison.OrdinalIgnoreCase) || status.Contains("Succeeded", StringComparison.OrdinalIgnoreCase)
            || status.Contains(": True", StringComparison.OrdinalIgnoreCase) || status.Equals("Bound", StringComparison.OrdinalIgnoreCase)
            || status.Equals("Available", StringComparison.OrdinalIgnoreCase) ? Color.Success : Color.Default;
    }
    private static string ResourceIdentity(KubernetesResourceItem item) => $"{item.GroupVersion}|{item.Namespace}|{item.Kind}|{item.Name}";
    private static string GetResourceIcon(string kind) => kind switch
    {
        "Pod" => Icons.Material.Filled.Memory,
        "Service" => Icons.Material.Filled.Hub,
        "Deployment" or "ReplicaSet" or "StatefulSet" or "DaemonSet" => Icons.Material.Filled.Widgets,
        "ConfigMap" or "Secret" or "PersistentVolumeClaim" => Icons.Material.Filled.Storage,
        "Ingress" or "Gateway" => Icons.Material.Filled.Dns,
        _ => Icons.Material.Filled.Inventory2
    };

