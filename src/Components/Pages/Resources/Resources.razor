    private async Task RunBatchAsync(string action, IReadOnlyCollection<KubernetesResourceItem> items)
    {
        if (items.Count == 0) return;
        var prompt = L["ConfirmBatchAction", action, items.Count].Value;
        if (!await JS.InvokeAsync<bool>("confirm", prompt)) return;
        _operationBusy = true;
        try
        {
            var results = action == L["DeleteSelected"].Value ? await AppEvents.DeleteResourcesAsync(items.ToArray())
                : action == L["StopSelected"].Value ? await AppEvents.StopResourcesAsync(items.Where(IsStoppable).ToArray())
                : await AppEvents.ResumeResourcesAsync(items.Where(IsResumable).ToArray());
            var succeeded = results.Count(result => result.Succeeded);
            var failed = results.Where(result => !result.Succeeded).Select(result => $"{result.Resource.Kind}/{result.Resource.Name}: {result.Message}").ToArray();
            _operationNotice = L["BatchActionResult", succeeded, results.Count];
            _error = failed.Length == 0 ? null : string.Join("\n", failed);
            _selectedResources.Clear();
            await RefreshWorkloadStatesAsync(items);
            await RefreshSelectedAsync();
        }
        finally { _operationBusy = false; }
    }
    private Task DeleteBatchAsync() => RunBatchAsync(L["DeleteSelected"].Value, SelectedResources.ToArray());
    private Task StopBatchAsync() => RunBatchAsync(L["StopSelected"].Value, SelectedResources.Where(IsStoppable).ToArray());
    private async Task ResumeBatchAsync()
    {
        var candidates = SelectedResources.Where(IsResumable).ToArray();
        await RunBatchAsync(L["ResumeSelected"].Value, candidates);
    }

