@page "/resources"
@implements IDisposable
@inject ClusterService ClusterService
@inject ApplicationEventManager AppEvents
@inject ResourceGraphService ResourceGraphService
@inject IStringLocalizer<AppStrings> L
@inject IJSRuntime JS

<PageTitle>@L["Resources"] | Kubernetes Visualizer</PageTitle>

<MudStack Spacing="4">
    <div>
        <MudText Typo="Typo.h4" GutterBottom="true">@L["Resources"]</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">@L["ResourcesDescription"]</MudText>
    </div>

    @if (!ClusterService.IsConnected)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@L["ConnectFromSettings"]</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4" Elevation="1">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <ResourceTypeSelector Label="@L["ResourceType"]"
                                      AvailableTypes="_types" SelectedTypes="_selectedTypes"
                                      SelectedTypesChanged="OnSelectedTypesChanged"
                                      SelectedCountFormat="@L["ResourceTypesSelectedCount"].Value"
                                      SelectFilteredText="@L["SelectAllFilteredResourceTypes"].Value"
                                      ClearFilteredText="@L["ClearFilteredResourceTypes"].Value"
                                      EmptyText="@L["NoMatchingResourceTypes"].Value" />
                <MudCheckBox T="bool" Value="_showAllResources" ValueChanged="OnShowAllResourcesChanged"
                             Label="@L["AllResources"]" Disabled="_loadingTypes" />
                <MudTextField T="string" Label="@L["FilterNameNamespace"]" Value="@_filter" ValueChanged="OnFilterChanged" Immediate="true"
                              Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshSelectedAsync"
                           Disabled="_loadingTypes || _loadingItems">@L["Refresh"]</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateManifest">@L["CreateFromYaml"]</MudButton>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["ObjectCount", FilteredItems.Count]</MudText>
            </MudStack>
            @if (_loadingTypes || _loadingItems)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-3" />
            }
        </MudPaper>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
        }
        @if (!string.IsNullOrWhiteSpace(_operationNotice))
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">@_operationNotice</MudAlert>
        }
        @if (_partialFailures.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                @L["SomeResourceTypesUnavailable", _partialFailures.Count]
                <MudTooltip Text="@string.Join(", ", _partialFailures)"><MudIcon Icon="@Icons.Material.Filled.Info" Class="ml-2" /></MudTooltip>
            </MudAlert>
        }
        @if (_selectedTypes.Count > 0 || _showAllResources)
        {
            @if (SelectedResources.Count > 0)
            {
                <MudPaper Class="pa-3 mb-2" Elevation="1">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                        <MudText Typo="Typo.body2">@L["SelectedResourceCount", SelectedResources.Count]</MudText>
                        <MudButton Color="Color.Error" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteBatchAsync" Disabled="_operationBusy">@L["DeleteSelected"]</MudButton>
                        @if (SelectedResources.Any(IsStoppable))
                        {
                            <MudButton Color="Color.Warning" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.StopCircle" OnClick="StopBatchAsync" Disabled="_operationBusy">@L["StopSelected"]</MudButton>
                        }
                        else if (SelectedResources.Any(IsResumable))
                        {
                            <MudButton Color="Color.Primary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="ResumeBatchAsync" Disabled="_operationBusy">@L["ResumeSelected"]</MudButton>
                        }
                    </MudStack>
                </MudPaper>
            }
            <MudTable T="KubernetesResourceItem" Items="FilteredItems" Hover="true" Dense="true" Striped="true" Elevation="1" MultiSelection="true" SelectOnRowClick="false" SelectedItems="_selectedResources" SelectedItemsChanged="@(selected => OnSelectedResourcesChanged(selected))" OnRowClick="@(EventCallback.Factory.Create<TableRowClickEventArgs<KubernetesResourceItem>>(this, OnResourceRowClick))" Class="resource-table">
                <HeaderContent>
                    <MudTh>@L["Kind"]</MudTh>
                    <MudTh>@L["Name"]</MudTh>
                    <MudTh>@L["Namespace"]</MudTh>
                    <MudTh>@L["Status"]</MudTh>
                    <MudTh>@L["Api"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["Kind"]">@context.Kind</MudTd>
                    <MudTd DataLabel="@L["Name"]">@context.Name</MudTd>
                    <MudTd DataLabel="@L["Namespace"]">@(string.IsNullOrWhiteSpace(context.Namespace) ? "—" : context.Namespace)</MudTd>
                    <MudTd DataLabel="@L["Status"]">
                        @if (string.IsNullOrWhiteSpace(context.Status)) { <span>@L["NotApplicable"]</span> }
                        else { <MudChip T="string" Size="Size.Small" Color="@GetResourceStatusColor(context.Status)">@context.Status</MudChip> }
                    </MudTd>
                    <MudTd DataLabel="@L["Api"]">@context.GroupVersion</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4" Color="Color.Secondary">@L["NoObjectsForFilter"]</MudText>
                </NoRecordsContent>
            </MudTable>
            @if (_selectedTypes.Any(type => type.Kind == "Secret") || (_showAllResources && _items.Any(item => item.Kind == "Secret")))
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">@L["SecretsMetadataOnly"]</MudAlert>
            }
        }

        @if (_detailsOpen && _selectedResource is not null)
        {
            <div class="resource-details-backdrop" @onclick="CloseDetails"></div>
            <aside class="resource-details-drawer" role="dialog" aria-modal="true" aria-labelledby="resource-list-details-title" tabindex="-1">
                <MudStack Spacing="3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <div>
                            <MudText Typo="Typo.overline" Color="Color.Primary">@_selectedResource.Kind · @_selectedResource.GroupVersion</MudText>
                            <MudText id="resource-list-details-title" Typo="Typo.h6">@_selectedResource.Name</MudText>
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" title="@L["Close"]" OnClick="CloseDetails" />
                    </MudStack>
                    <MudText Typo="Typo.body2">@L["Namespace"]: @(string.IsNullOrWhiteSpace(_selectedResource.Namespace) ? L["ClusterScope"] : _selectedResource.Namespace)</MudText>
                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                        @if (_selectedResource.Kind != "Secret")
                        {
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.EditNote" OnClick="OpenEditManifestAsync">@L["EditYaml"]</MudButton>
                        }
                        @if (_selectedResource.Kind == "Pod")
                        {
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Terminal" OnClick="OpenPodLogsAsync">@L["ViewLogs"]</MudButton>
                        }
                        @if (IsStoppable(_selectedResource))
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.StopCircle" OnClick="StopSelectedWorkloadAsync">@L["StopWorkload"]</MudButton>
                        }
                        else if (IsResumable(_selectedResource))
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="ResumeSelectedWorkloadAsync">@L["ResumeWorkload"]</MudButton>
                        }
                        @if (_workloadStateLoading && IsScalable(_selectedResource)) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteSelectedAsync">@L["DeleteResource"]</MudButton>
                    </MudStack>
                    @if (_selectedResource.Kind == "Secret")
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">@L["SecretEditDisabled"]</MudAlert>
                        <MudButton Variant="Variant.Outlined" StartIcon="@(_secretRevealed ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)" OnClick="ToggleSecretRevealAsync" Disabled="_secretLoading">
                            @(_secretRevealed ? L["HideSecretValues"] : L["RevealSecretValues"])
                        </MudButton>
                        @if (_secretLoading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" /> }
                        @if (_secretRevealed)
                        {
                            @foreach (var pair in _secretData)
                            {
                                <MudTextField T="string" Label="@pair.Key" Value="@pair.Value" ReadOnly="true" Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy" OnAdornmentClick="@(() => CopySecretValueAsync(pair.Value))" />
                            }
                            @if (_secretData.Count == 0) { <MudText Color="Color.Secondary">@L["SecretHasNoData"]</MudText> }
                        }
                    }
                    @if (_selectedResource.Kind == "Pod")
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">@L["PodControlNote"]</MudAlert>
                    }
                    @if (!string.IsNullOrWhiteSpace(_selectedResource.Status))
                    {
                        <MudChip T="string" Size="Size.Small" Color="@GetResourceStatusColor(_selectedResource.Status)" Variant="Variant.Outlined">@_selectedResource.Status</MudChip>
                    }
                    <MudDivider />
                    <MudText Typo="Typo.subtitle1">@L["RelatedResources"]</MudText>
                    @if (_relatedLoading)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                    }
                    else if (_relatedResources.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["NoRelatedResources"]</MudText>
                    }
                    else
                    {
                        <MudStack Spacing="1">
                            @foreach (var related in _relatedResources)
                            {
                                <MudTooltip Text="@related.Relationship">
                                    <MudButton Class="related-resource-link" Variant="Variant.Text" StartIcon="@GetResourceIcon(related.Resource.Kind)" OnClick="() => OpenRelatedResourceAsync(related.Resource)">
                                        <span>@related.Resource.Kind · @related.Resource.Name</span>
                                    </MudButton>
                                </MudTooltip>
                            }
                        </MudStack>
                    }
                    @if (_showYaml && _selectedResource.Kind == "Secret")
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">@L["SecretYamlRedacted"]</MudAlert>
                    }
                    @if (_showYaml)
                    {
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Info" OnClick="ToggleYamlAsync">@L["ShowDetails"]</MudButton>
                        @if (_yamlLoading)
                        {
                            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                        }
                        else if (!string.IsNullOrWhiteSpace(_selectedYaml))
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="yaml-reader-toolbar">
                                <MudText Typo="Typo.subtitle2">@L["ObservedYaml"]</MudText>
                                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyYamlAsync">@(_yamlCopied ? L["YamlCopied"] : L["CopyYaml"])</MudButton>
                            </MudStack>
                            @if (_yamlCopyFailed)
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true">@L["ClipboardUnavailable"]</MudAlert>
                            }
                            <pre class="resource-yaml-view">@_selectedYaml</pre>
                        }
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Code" OnClick="ToggleYamlAsync">@L["ViewAsYaml"]</MudButton>
                        @if ((_selectedResource.Labels?.Count ?? 0) > 0)
                        {
                            <MudDivider />
                            <MudText Typo="Typo.subtitle2">@L["Labels"]</MudText>
                            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                                @foreach (var label in _selectedResource.Labels!)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@label.Key=@label.Value</MudChip>
                                }
                            </MudStack>
                        }
                        @if ((_selectedResource.Annotations?.Count ?? 0) > 0)
                        {
                            <MudDivider />
                            <MudText Typo="Typo.subtitle2">@L["Annotations"]</MudText>
                            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                                @foreach (var annotation in _selectedResource.Annotations!)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@annotation.Key=@TruncateAnnotation(annotation.Value)</MudChip>
                                }
                            </MudStack>
                        }
                    }
                </MudStack>
            </aside>
        }
        @if (_manifestEditorOpen)
        {
            <div class="resource-details-backdrop" @onclick="CloseManifestEditor"></div>
            <section class="resource-details-drawer manifest-editor" role="dialog" aria-modal="true" aria-labelledby="manifest-editor-title">
                <MudStack Spacing="3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText id="manifest-editor-title" Typo="Typo.h6">@(_editingManifest ? L["EditManifest"] : L["CreateManifest"])</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" title="@L["Close"]" OnClick="CloseManifestEditor" />
                    </MudStack>
                    <MudAlert Severity="Severity.Info" Dense="true">@L["ManifestApplyContext", ClusterService.CurrentContextName ?? "—", ClusterService.CurrentNamespace ?? L["ClusterScope"].Value]</MudAlert>
                    @if (!string.IsNullOrWhiteSpace(_manifestError)) { <MudAlert Severity="Severity.Error">@_manifestError</MudAlert> }
                    <MudTextField T="string" @bind-Value="_manifestYaml" Lines="24" Variant="Variant.Outlined" FullWidth="true" Disabled="_operationBusy" Class="manifest-editor-input" />
                    <MudStack Row="true" Justify="Justify.FlexEnd">
                        <MudButton Variant="Variant.Text" OnClick="CloseManifestEditor" Disabled="_operationBusy">@L["Cancel"]</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Publish" OnClick="ApplyManifestAsync" Disabled="_operationBusy || string.IsNullOrWhiteSpace(_manifestYaml)">@L["ApplyManifest"]</MudButton>
                    </MudStack>
                </MudStack>
            </section>
        }
        @if (_logsOpen && _selectedResource is not null)
        {
            <div class="resource-details-backdrop" @onclick="CloseLogs"></div>
            <aside class="resource-details-drawer resource-log-drawer" role="dialog" aria-modal="true" aria-labelledby="pod-logs-title">
                <MudStack Spacing="3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <div><MudText Typo="Typo.overline">Pod</MudText><MudText id="pod-logs-title" Typo="Typo.h6">@_selectedResource.Name — @L["ViewLogs"]</MudText></div>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" title="@L["Close"]" OnClick="CloseLogs" />
                    </MudStack>
                    <MudSelect T="string" Label="@L["Container"]" Value="_selectedLogContainer" ValueChanged="LoadPodLogsAsync" Variant="Variant.Outlined" Dense="true">
                        @foreach (var container in _logContainers) { <MudSelectItem Value="@container">@container</MudSelectItem> }
                    </MudSelect>
                    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="2" Class="resource-log-toolbar">
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshPodLogsAsync" Disabled="_logsLoading">@L["RefreshLogs"]</MudButton>
                        <MudSwitch T="bool" Value="_autoRefreshLogs" ValueChanged="OnAutoRefreshChanged">@L["AutoRefreshLogs"]</MudSwitch>
                        <MudNumericField T="int" Label="@L["LogTailLines"]" Value="_logTailLines" ValueChanged="OnLogTailLinesChanged" Min="1" Max="5000" Variant="Variant.Outlined" Style="max-width:150px" />
                        <MudSwitch T="bool" Value="_followLogBottom" ValueChanged="OnFollowLogBottomChanged">@L["FollowLogBottom"]</MudSwitch>
                    </MudStack>
                    @if (_logsLoading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" /> }
                    @if (!string.IsNullOrWhiteSpace(_logsError)) { <MudAlert Severity="Severity.Error">@_logsError</MudAlert> }
                    <pre class="pod-log-output" @ref="_logOutput">@_podLogs</pre>
                </MudStack>
            </aside>
        }
    }
</MudStack>

@code {
    private IReadOnlyList<KubernetesResourceType> _types = [];
    private IReadOnlyList<KubernetesResourceItem> _items = [];
    private List<KubernetesResourceType> _selectedTypes = [];
    private string[] _pendingSelectedTypeKeys = [];
    private bool _hasPersistedTypeSelection;
    private bool _showAllResources;
    private string _filter = string.Empty;
    private string? _error;
    private IReadOnlyList<string> _partialFailures = [];
    private bool _loadingTypes;
    private bool _loadingItems;
    private bool _preferencesRestored;
    private bool _detailsOpen;
    private bool _showYaml;
    private bool _yamlLoading;
    private bool _yamlCopied;
    private bool _yamlCopyFailed;
    private string? _selectedYaml;
    private KubernetesResourceItem? _selectedResource;
    private HashSet<KubernetesResourceItem> _selectedResources = [];
    private readonly Dictionary<string, WorkloadReplicaState> _workloadStates = new(StringComparer.Ordinal);
    private bool _workloadStateLoading;
    private bool _secretLoading;
    private bool _secretRevealed;
    private IReadOnlyDictionary<string, string> _secretData = new Dictionary<string, string>();
    private IReadOnlyList<RelatedResourceLink> _relatedResources = [];
    private bool _relatedLoading;
    private bool _manifestEditorOpen;
    private bool _editingManifest;
    private bool _operationBusy;
    private string _manifestYaml = string.Empty;
    private string? _manifestError;
    private string? _operationNotice;
    private bool _logsOpen;
    private bool _logsLoading;
    private bool _autoRefreshLogs;
    private string? _logsError;
    private string _podLogs = string.Empty;
    private string? _selectedLogContainer;
    private IReadOnlyList<string> _logContainers = [];
    private int _logTailLines = 200;
    private bool _followLogBottom = true;
    private ElementReference _logOutput;
    private System.Threading.Timer? _logsTimer;
    private CancellationTokenSource? _resourceLoad;
    private long _lastSelectionRevision;
    private IReadOnlyList<KubernetesResourceItem> FilteredItems => _items.Where(item =>
        string.IsNullOrWhiteSpace(_filter) || item.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)
        || item.Namespace.Contains(_filter, StringComparison.OrdinalIgnoreCase)).ToArray();
    private IReadOnlyCollection<KubernetesResourceItem> SelectedResources => _selectedResources;

    protected override void OnInitialized() => AppEvents.SelectionChanged += OnSelectionChanged;

    protected override async Task OnInitializedAsync() => await RefreshCatalogAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_logsOpen && _followLogBottom && !_logsLoading)
        {
            try { await JS.InvokeVoidAsync("kvLogs.scrollBottom", _logOutput); } catch (JSException) { }
        }
        if (!firstRender || _preferencesRestored) return;
        _preferencesRestored = true;
        try
        {
            var preferences = await JS.InvokeAsync<ResourceListUiPreferences?>("kvUiState.read", "resources");
            if (preferences is not null)
            {
                _hasPersistedTypeSelection = preferences.SelectedResourceKeys is not null
                    || preferences.ShowAllResources || !string.IsNullOrWhiteSpace(preferences.SelectedResourceKey);
                _pendingSelectedTypeKeys = preferences.SelectedResourceKeys
                    ?? (string.IsNullOrWhiteSpace(preferences.SelectedResourceKey) ? [] : [preferences.SelectedResourceKey]);
                _showAllResources = preferences.ShowAllResources;
                _filter = preferences.Search ?? string.Empty;
                if (ClusterService.IsConnected) await RefreshCatalogAsync();
                await InvokeAsync(StateHasChanged);
            }
            var tail = await AppEvents.GetApplicationSettingAsync("logs.tail_lines");
            if (int.TryParse(tail, out var lines)) _logTailLines = Math.Clamp(lines, 1, 5000);
            _followLogBottom = await AppEvents.GetApplicationSettingAsync("logs.follow_bottom") != "false";
        }
        catch (JSException) { }
    }

    private async Task RefreshCatalogAsync()
    {
        if (!ClusterService.IsConnected || ClusterService.IsLoading) return;
        ResourceGraphService.Invalidate();
        _loadingTypes = true;
        _error = null;
        try
        {
            _types = await ClusterService.GetResourceTypesAsync();
            _selectedTypes = _showAllResources ? [] : _types
                .Where(item => _pendingSelectedTypeKeys.Contains(ResourceKey(item), StringComparer.Ordinal)).ToList();
            if (!_hasPersistedTypeSelection && !_showAllResources && _selectedTypes.Count == 0)
                _selectedTypes = _types.Where(item => item.Kind == "Pod").Take(1).ToList();
            if (_showAllResources) await LoadAllResourcesAsync();
            else if (_selectedTypes.Count > 0) await LoadSelectedResourcesAsync();
        }
        catch (Exception exception)
        {
            _error = $"{L["CouldNotLoadDiscovery"]}: {exception.Message}";
        }
        finally { _loadingTypes = false; }
    }

    private async Task OnSelectedTypesChanged(IReadOnlyCollection<KubernetesResourceType> selectedTypes)
    {
        _selectedTypes = selectedTypes.ToList();
        _pendingSelectedTypeKeys = _selectedTypes.Select(ResourceKey).ToArray();
        _hasPersistedTypeSelection = true;
        _showAllResources = false;
        _items = [];
        _partialFailures = [];
        await InvokeAsync(StateHasChanged);
        if (_selectedTypes.Count > 0) await LoadSelectedResourcesAsync();
        else _resourceLoad?.Cancel();
        await PersistUiPreferencesAsync();
    }

    private async Task OnShowAllResourcesChanged(bool showAllResources)
    {
        _showAllResources = showAllResources;
        _hasPersistedTypeSelection = true;
        _selectedTypes = [];
        _pendingSelectedTypeKeys = [];
        _items = [];
        _partialFailures = [];
        if (_showAllResources) await LoadAllResourcesAsync();
        else _resourceLoad?.Cancel();
        await PersistUiPreferencesAsync();
    }

    private string ResourceTypeText(KubernetesResourceType type) => $"{type.Kind} ({type.Name})";
    private string SelectedResourceTypeCountText(int count) => L["ResourceTypesSelectedCount", count].Value;

    private async Task OnFilterChanged(string? value)
    {
        _filter = value ?? string.Empty;
        await PersistUiPreferencesAsync();
    }

    private Task PersistUiPreferencesAsync() => JS.InvokeVoidAsync("kvUiState.write", "resources",
        new ResourceListUiPreferences(_selectedTypes.Count == 1 ? ResourceKey(_selectedTypes[0]) : null,
            _filter, _selectedTypes.Select(ResourceKey).ToArray(), _showAllResources)).AsTask();

    private async Task SelectResourceAsync(KubernetesResourceItem resource)
    {
        _selectedResource = resource;
        _detailsOpen = true;
        _showYaml = false;
        _selectedYaml = null;
        _yamlCopied = false;
        _yamlCopyFailed = false;
        _secretRevealed = false;
        _secretData = new Dictionary<string, string>();
        _ = LoadWorkloadStateAsync(resource);
        await LoadRelatedResourcesAsync(resource);
    }

    private async Task OnResourceRowClick(TableRowClickEventArgs<KubernetesResourceItem> args)
    {
        if (args.Item is not null) await SelectResourceAsync(args.Item);
    }

    private async Task LoadRelatedResourcesAsync(KubernetesResourceItem resource)
    {
        _relatedResources = [];
        _relatedLoading = true;
        try
        {
            var snapshot = await ResourceGraphService.LoadAsync(ClusterService.CurrentNamespace ?? resource.Namespace);
            var graphItem = snapshot.Items.FirstOrDefault(item => item.Kind == resource.Kind
                && item.Name == resource.Name && item.Namespace == resource.Namespace);
            if (graphItem is null) return;
            var byUid = snapshot.Items.Where(item => !string.IsNullOrWhiteSpace(item.Uid))
                .GroupBy(item => item.Uid, StringComparer.Ordinal)
                .ToDictionary(group => group.Key, group => group.First(), StringComparer.Ordinal);
            var relatedLabelKeys = await AppEvents.GetRelatedLabelKeysAsync();
            var relations = ResourceGraphService.BuildRelations(snapshot.Items, relatedLabelKeys).Edges;
            var related = new Dictionary<string, RelatedResourceLink>(StringComparer.Ordinal);
            foreach (var edge in relations.Where(edge => edge.SourceId == graphItem.Uid || edge.TargetId == graphItem.Uid))
            {
                var targetId = edge.SourceId == graphItem.Uid ? edge.TargetId : edge.SourceId;
                if (byUid.TryGetValue(targetId, out var target))
                    related[targetId] = ToRelatedLink(target, edge);
                if (edge.Relationship == "shared-label" && edge.LabelKey is not null)
                {
                    foreach (var member in snapshot.Items.Where(item => item.Uid != graphItem.Uid
                                 && item.Labels.TryGetValue(edge.LabelKey, out var value) && value == edge.LabelValue))
                        related[member.Uid] = ToRelatedLink(member, edge);
                }
            }
            _relatedResources = related.Values
                .DistinctBy(link => ResourceIdentity(link.Resource))
                .OrderBy(link => link.Resource.Kind, StringComparer.OrdinalIgnoreCase)
                .ThenBy(link => link.Resource.Name, StringComparer.OrdinalIgnoreCase).ToArray();
        }
        catch (Exception exception)
        {
            _error = $"{L["CouldNotLoadResourceTree"]}: {exception.Message}";
        }
        finally { _relatedLoading = false; }
    }

    private RelatedResourceLink ToRelatedLink(KubernetesResourceGraphItem target, KubernetesGraphEdge edge)
    {
        var axes = edge.Axis.Split('+', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(axis => axis switch
            {
                "property" => L["GraphAxisProperty"].Value,
                "control" => L["GraphAxisControl"].Value,
                "reference" => L["GraphAxisReference"].Value,
                "selection" => L["GraphAxisSelection"].Value,
                "protection" => L["GraphAxisProtection"].Value,
                "label-association" => L["GraphAxisLabel"].Value,
                _ => axis
            });
        var axisText = string.Join(" + ", axes);
        if (axisText.Length == 0) axisText = L["CompositionRelationLegend"].Value;
        var field = edge.LabelKey is null ? edge.FieldPath : $"metadata.labels[{edge.LabelKey}]={edge.LabelValue}";
        var inferred = edge.IsInferred ? $" · {L["InferredRelation"].Value}" : string.Empty;
        var item = new KubernetesResourceItem(target.Kind, target.Name, target.Namespace, target.Status,
            target.GroupVersion, target.ResourceName, target.IsKubernetesSystemManaged, target.IsControllerManaged,
            target.Labels, target.Annotations);
        return new RelatedResourceLink(item, $"{axisText}: {field}{inferred}");
    }

    private async Task OpenRelatedResourceAsync(KubernetesResourceItem resource)
    {
        var type = _types.FirstOrDefault(candidate => candidate.Kind == resource.Kind
            && candidate.GroupVersion == resource.GroupVersion && candidate.Name == resource.ResourceName);
        if (type is null) return;
        _selectedTypes = [type];
        _pendingSelectedTypeKeys = [ResourceKey(type)];
        _showAllResources = false;
        await LoadSelectedResourcesAsync();
        var target = _items.FirstOrDefault(item => item.Kind == resource.Kind && item.Name == resource.Name
            && item.Namespace == resource.Namespace);
        if (target is not null) await SelectResourceAsync(target);
        await PersistUiPreferencesAsync();
    }


