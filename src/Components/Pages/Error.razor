@page "/Error"
@using System.Diagnostics
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["ErrorTitle"]</PageTitle>

<h1 class="text-danger">@L["ErrorTitle"]</h1>
<h2 class="text-danger">@L["ErrorDescription"]</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@L["RequestId"]</strong> <code>@RequestId</code>
    </p>
}

<h3>@L["DevelopmentMode"]</h3>
<p>@L["DevelopmentModeDescription"]</p>

@code{
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;

}
