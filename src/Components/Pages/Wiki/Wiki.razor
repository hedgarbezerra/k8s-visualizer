@page "/wiki"
@inject IStringLocalizer<WikiResources> L

<PageTitle>@L["Wiki.Support"] | Kubernetes Visualizer</PageTitle>

<MudStack Spacing="4" Class="wiki-page">
    <MudPaper Class="wiki-hero pa-6" Elevation="0">
        <MudText Typo="Typo.overline">KUBERNETES VISUALIZER · @L["Wiki.Support"]</MudText>
        <MudText Typo="Typo.h3" Class="wiki-hero-title">@L["Wiki.HeroTitle"]</MudText>
        <MudText Typo="Typo.body1" Class="wiki-hero-description">@L["Wiki.HeroDescription"]</MudText>
    </MudPaper>
    <KubernetesWikiContent />
</MudStack>
